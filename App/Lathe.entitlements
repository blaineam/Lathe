<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      The hardened runtime is required for notarization, and it blocks a
      process from mapping writable-then-executable pages. CPython does exactly
      that when it loads, so without this entitlement the interpreter fails to
      start and every extractor silently becomes unavailable — the app still
      runs, still downloads direct links, and simply reports that no extractor
      could be found, which is the most confusing possible symptom.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!--
      The Python packages the user installs are not part of the signed bundle,
      so the library validation that the hardened runtime enforces would refuse
      to load them.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
